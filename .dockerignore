# Docker and CDK's DockerImageAsset only read the .dockerignore at the build
# context root. The demo-ui image builds from the repo root so pnpm can see the
# lockfile. This is an allowlist so new packages stay out of the context.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.pnpmrc
!tsconfig.json
!services/demo-ui
services/demo-ui/node_modules
services/demo-ui/.next
services/demo-ui/README.md
services/demo-ui/scripts
