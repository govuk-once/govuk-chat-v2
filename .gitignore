# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# NodeJS files
node_modules

# CDK files
cdk.out
/cdk/cache/*
!/cdk/cache/.keep

# Stack outputs, written per developer by dev-cdk-deploy.sh
/cdk/cdk-outputs/*
!/cdk/cdk-outputs/.keep

# AgentCore CLI local state, generated per developer by the local development
# tooling
services/*/agentcore/.cli/
services/*/agentcore/.cache/
services/*/agentcore/aws-targets.json

# Individual env vars
.env
.env*
!.env.example

# Virtual environments
.venv
